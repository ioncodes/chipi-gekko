decoder Dsp {
    width = 16
    bit_order = msb0
    max_units = 2
}

clr15   [0:15]=1000110000000000
        | "CLR15"

s16     [0:15]=1000111000000000
        | "S16"

m0      [0:15]=1000101100000000
        | "M0"

sbclr   [0:10]=00010010000 bit:u5[11:15]
        | "SBCLR #{bit}"

sbset   [0:10]=00010011000 bit:u5[11:15]
        | "SBSET #{bit}"

lri     [0:7]=00000000 [8]=1 rd:u7[9:15] imm:u16[16:31]
        | "LRI ${rd}, #0x{imm:04x}"

si      [0:7]=00010110 addr:u8[8:15] val:u16[16:31]
        | "SI @0x{addr:04x}, #0x{val:04x}"